---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { CONTACT, FULL_ADDRESS } from '../config/site';

const mapQuery = encodeURIComponent(FULL_ADDRESS);
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---
<Base
  title="Contact Us"
  description="Reach Zion Classique Care & Human Services in Chandler, AZ. Call us 24/7, send a message, or stop by. Help is only one call away."
>
  <PageHeader
    eyebrow="Contact us"
    title="Help is only one call away"
    text="Reach out however feels easiest. A real person is ready to listen — 24 hours a day, every day."
  />

  <section class="bg-ink">
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-2">
      <!-- Left: contact methods -->
      <div class="reveal space-y-8">
        <!-- Phones -->
        <div>
          <h2 class="flex items-center gap-2 text-h3"><Icon name="phone" class="h-6 w-6 text-gold" /> Call us</h2>
          <ul class="mt-4 space-y-3">
            {CONTACT.phones.map((p) => (
              <li>
                <a href={`tel:${p.tel}`} class="inline-flex items-center gap-2 font-display text-2xl text-cream hover:text-gold">
                  {p.label}
                  {p.primary && <span class="rounded-full bg-gold/15 px-2 py-0.5 text-caption font-semibold text-gold">Primary</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Email -->
        <div>
          <h2 class="flex items-center gap-2 text-h3"><Icon name="mail" class="h-6 w-6 text-gold" /> Email us</h2>
          <a href={`mailto:${CONTACT.email}`} class="mt-3 inline-block text-lg text-cream hover:text-gold">{CONTACT.email}</a>
        </div>

        <!-- Address -->
        <div>
          <h2 class="flex items-center gap-2 text-h3"><Icon name="pin" class="h-6 w-6 text-gold" /> Visit us</h2>
          <a href={mapsLink} target="_blank" rel="noopener" class="mt-3 inline-block text-lg text-cream hover:text-gold">{FULL_ADDRESS}</a>
        </div>

        <!-- Hours -->
        <div class="card flex items-center gap-3 p-5">
          <Icon name="clock" class="h-6 w-6 shrink-0 text-gold" />
          <p class="text-cream/90">{CONTACT.hours}</p>
        </div>
      </div>

      <!-- Right: form -->
      <div class="reveal">
        <ContactForm />
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-charcoal">
    <div class="container-page py-12 sm:py-16">
      <h2 class="sr-only">Map and directions</h2>
      <p class="mb-4 text-center text-cream/90">{FULL_ADDRESS}</p>
      <div class="overflow-hidden rounded-card border border-gold/15">
        <iframe
          title={`Map showing ${FULL_ADDRESS}`}
          src={mapSrc}
          width="100%"
          height="420"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>
