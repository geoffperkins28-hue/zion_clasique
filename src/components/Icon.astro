---
/**
 * Thin inline Lucide line icons (no runtime dependency). Add new entries to the
 * `paths` map as needed. All use the standard 24x24 stroke style.
 */
interface Props { name: string; class?: string; }
const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<string, string> = {
