  // Progressive phases — steps / trending up
  steps: '<path d="M3 17h4v4M3 21l6-6h4l4-4h4"/><path d="M17 7h4v4"/>',
  // Community engagement — users
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  // Counseling — message circle / heart talk
  talk: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  // Life skills — sprout / growth
  sprout: '<path d="M7 20h10"/><path d="M12 20c0-6 0-9 0-9"/><path d="M12 11c0-3-2-5-5-5 0 3 2 5 5 5z"/><path d="M12 8c0-2 2-4 5-4 0 2-2 4-5 4z"/>',
  // Vocational — briefcase
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>',
