---
import FleurDeLis from './FleurDeLis.astro';
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}
const { eyebrow, title, text } = Astro.props;
---
<section class="relative overflow-hidden bg-charcoal">
  <FleurDeLis class="pointer-events-none absolute left-1/2 top-1/2 h-[120%] w-auto -translate-x-1/2 -translate-y-1/2 text-gold opacity-[0.04]" />
  <div class="container-page relative py-16 text-center sm:py-24">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="mt-3 text-h1">{title}</h1>
    {text && <p class="lede mx-auto mt-5 max-w-2xl text-cream">{text}</p>}
  </div>
</section>
