---
import { PRIMARY_PHONE } from '../config/site';
---
<!-- Persistent click-to-call button, mobile only. Reinforces primary conversion. -->
<a
  href={`tel:${PRIMARY_PHONE.tel}`}
  class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-gold text-ink shadow-[0_10px_30px_-8px_rgba(201,162,75,0.8)] transition-transform duration-200 hover:scale-105 active:scale-95 lg:hidden"
  aria-label={`Call us now at ${PRIMARY_PHONE.label}`}
>
  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
  </svg>
</a>
