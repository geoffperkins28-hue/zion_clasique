---
interface Props {
  name: string;
  relationship?: string;
  rating?: number;
  quote: string;
}
const { name, relationship, rating = 5, quote } = Astro.props;
const stars = Math.max(1, Math.min(5, Math.round(rating)));
---
<figure class="card card-hover flex h-full flex-col p-6 sm:p-7">
  <div class="mb-4 flex gap-1" aria-label={`${stars} out of 5 stars`} role="img">
    {Array.from({ length: 5 }).map((_, i) => (
      <svg class:list={['h-5 w-5', i < stars ? 'text-gold' : 'text-gold/20']} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.95 6.18 6.8.78-5.05 4.6 1.36 6.7L12 17.6 5.94 20.96l1.36-6.7L2.25 9.66l6.8-.78z" />
      </svg>
    ))}
  </div>
  <blockquote class="flex-1 text-cream/90">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="mt-5 border-t border-gold/10 pt-4">
    <span class="block font-display text-lg text-cream">{name}</span>
    {relationship && <span class="text-caption text-sand">{relationship}</span>}
  </figcaption>
</figure>
